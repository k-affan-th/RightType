<?xml version="1.0" encoding="utf-8"?>
<!-- Filled in by packaging/msix.ps1. Identity/Publisher come from Partner Center
     (Product identity page of the MSIX product); never guess them. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <Identity Name="@IDENTITY_NAME@" Publisher="@PUBLISHER@" Version="@VERSION@" ProcessorArchitecture="@ARCH@" />

  <Properties>
    <DisplayName>RightType</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
    <Resource Language="th-th" />
  </Resources>

  <Applications>
    <Application Id="RightType" Executable="righttype.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="RightType"
        Description="Fix text typed with the wrong keyboard layout (Thai/English), automatically or with a hotkey."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- TaskId must match TASK_ID in src/startup.rs. -->
        <uap5:Extension Category="windows.startupTask" Executable="righttype.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="RightTypeStartup" Enabled="false" DisplayName="RightType" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Needed for the low-level keyboard hook (WH_KEYBOARD_LL) and SendInput. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
